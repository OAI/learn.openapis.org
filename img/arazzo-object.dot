digraph arazzoObject {
  node [shape = none; fontname = monospace; tooltip = "Click to jump to the specification of this object";];
  rankdir = LR;
  bgcolor = white;

  arazzoObject [URL = "https://spec.openapis.org/arazzo/v1.1.0.html#arazzo-specification-object"; target = "_blank"; label = <<table border="0" cellspacing="0">
    <tr><td border="1" bgcolor="#94d60a" port="header"><font face="arial"><b>&#160;Arazzo Specification Object&#160;</b></font></td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="arazzo">arazzo</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="self">$self</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="info">info</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="sourceDescriptions">sourceDescriptions</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="workflows">workflows</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="components">components</td></tr>
    </table>>;];

  infoObject [URL = "https://spec.openapis.org/arazzo/v1.1.0.html#info-object"; target = "_blank"; label = <<table border="0" cellspacing="0">
    <tr><td border="1" bgcolor="#94d60a" port="header"><font face="arial"><b>&#160;Info Object&#160;</b></font></td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="title">title</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="summary">summary</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="description">description</td></tr>
    <tr><td border="1" bgcolor="#6ca437" port="version">version</td></tr>
    </table>>;];

  sourceObject [URL = "https://spec.openapis.org/arazzo/v1.1.0.html#source-description-object"; target = "_blank"; label = <<table border="0" cellspacing="0">
    <tr><td border="1" bgcolor="#939598" port="header"><font face="arial"><b>&#160;Source Description Object&#160;</b></font></td></tr>
    <tr><td border="1" bgcolor="#6d6e71">…</td></tr>
    </table>>;];

  workflowObject [URL = "https://spec.openapis.org/arazzo/v1.1.0.html#workflow-object"; target = "_blank"; label = <<table border="0" cellspacing="0">
    <tr><td border="1" bgcolor="#939598" port="header"><font face="arial"><b>&#160;Workflow Object&#160;</b></font></td></tr>
    <tr><td border="1" bgcolor="#6d6e71">…</td></tr>
    </table>>;];

  componentsObject [URL = "https://spec.openapis.org/arazzo/v1.1.0.html#components-object"; target = "_blank"; label = <<table border="0" cellspacing="0">
    <tr><td border="1" bgcolor="#939598" port="header"><font face="arial"><b>&#160;Components Object&#160;</b></font></td></tr>
    <tr><td border="1" bgcolor="#6d6e71">…</td></tr>
    </table>>;];

  arazzoObject:info -> infoObject:header;
  arazzoObject:sourceDescriptions -> sourceObject:header;
  arazzoObject:workflows -> workflowObject:header;
  arazzoObject:components -> componentsObject:header;
}
